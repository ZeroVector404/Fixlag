local function resetAllToggles(except)
    local toggles = {"OptLevel1", "OptLevel2", "OptLevel3", "OptLevel4", "OptLevel5", "OptLevel6"}
    for _, toggle in ipairs(toggles) do
        if toggle ~= except and Options[toggle] then
            Options[toggle]:SetValue(false)
        end
    end
end

local function applyOptimization(level, enable)
    if not enable then
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            local Lighting = game:GetService("Lighting")
            Lighting.GlobalShadows = true
            Lighting.FogEnd = 100000
            Lighting.Brightness = 1
            activeOptLevel = 0
            Fluent:Notify({
                Title = "🔄 Reset Complete",
                Content = "Graphics restored to default",
                Duration = 3
            })
        end)
        return
    end

    local percentage = level * 10 + 30

    Fluent:Notify({
        Title = "🚀 Optimizing Level " .. level,
        Content = "Removing " .. percentage .. "% + Clothes + Textures...",
        Duration = 3
    })

    task.spawn(function()
        local removed = 0

        pcall(function()
            for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                if player.Character then
                    for _, accessory in pairs(player.Character:GetDescendants()) do
                        if accessory:IsA("Accessory") or accessory:IsA("Hat") then
                            accessory:Destroy()
                            removed = removed + 1
                        elseif accessory:IsA("Shirt") or accessory:IsA("Pants") or accessory:IsA("ShirtGraphic") then
                            accessory:Destroy()
                            removed = removed + 1
                        elseif accessory:IsA("CharacterMesh") then
                            accessory:Destroy()
                            removed = removed + 1
                        end
                    end
                end
            end

            for _, obj in pairs(workspace:GetDescendants()) do
                if math.random(1, 100) <= percentage then
                    pcall(function()
                        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
                            or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                            obj:Destroy()
                            removed = removed + 1
                        elseif obj:IsA("Decal") or obj:IsA("Texture") then
                            obj:Destroy()
                            removed = removed + 1
                        elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                            obj:Destroy()
                            removed = removed + 1
                        elseif obj:IsA("SpecialMesh") then
                            obj.TextureId = ""
                            removed = removed + 1
                        elseif obj:IsA("MeshPart") then
                            obj.TextureID = ""
                            removed = removed + 1
                        elseif obj:IsA("BasePart") then
                            obj.CastShadow = false
                            obj.Material = Enum.Material.SmoothPlastic
                            obj.Reflectance = 0
                            obj.TopSurface = Enum.SurfaceType.Smooth
                            obj.BottomSurface = Enum.SurfaceType.Smooth
                        end
                    end)
                end
            end

            for _, npc in pairs(workspace:GetDescendants()) do
                pcall(function()
                    if npc:IsA("Model") and npc:FindFirstChildOfClass("Humanoid") then
                        for _, item in pairs(npc:GetDescendants()) do
                            if item:IsA("Accessory") or item:IsA("Hat")
                                or item:IsA("Shirt") or item:IsA("Pants")
                                or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
                                item:Destroy()
                                removed = removed + 1
                            elseif item:IsA("Decal") or item:IsA("Texture") then
                                item:Destroy()
                                removed = removed + 1
                            end
                        end
                    end
                end)
            end

            for _, effect in pairs(game:GetService("Lighting"):GetChildren()) do
                if math.random(1, 100) <= percentage then
                    pcall(function()
                        if effect:IsA("BloomEffect") or effect:IsA("BlurEffect")
                            or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect")
                            or effect:IsA("DepthOfFieldEffect") or effect:IsA("Atmosphere")
                            or effect:IsA("Sky") or effect:IsA("Clouds") then
                            effect:Destroy()
                            removed = removed + 1
                        end
                    end)
                end
            end

            if level == 6 then
                local terrain = workspace:FindFirstChildOfClass("Terrain")
                if terrain then
                    terrain:Clear()
                    removed = removed + 1
                end

                local Lighting = game:GetService("Lighting")
                for _, child in pairs(Lighting:GetChildren()) do
                    pcall(function()
                        child:Destroy()
                        removed = removed + 1
                    end)
                end

                for _, obj in pairs(workspace:GetDescendants()) do
                    pcall(function()
                        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart"
                            and not obj:IsDescendantOf(game.Players.LocalPlayer.Character) then
                            -- ห้ามลบ/ซ่อน part ที่อยู่ใน model ที่มี Humanoid
                            local parentModel = obj:FindFirstAncestorWhichIsA("Model")
                            if parentModel and parentModel:FindFirstChildOfClass("Humanoid") then
                                return
                            end
                            if math.random(1, 100) <= 90 then
                                obj.Transparency = 1
                                obj.CanCollide = false
                                obj.CastShadow = false
                                removed = removed + 1
                            end
                        end
                    end)
                end

                Lighting.Ambient = Color3.fromRGB(255, 255, 255)
                Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
                Lighting.Brightness = 5
                Lighting.FogEnd = 9e9
            end

            local Lighting = game:GetService("Lighting")
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.Brightness = 2 + (level * 0.3)

            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            settings().Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01

            pcall(function()
                game:GetService("UserSettings"):GetService("UserGameSettings").SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
            end)

            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain and level >= 2 then
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 1
                terrain.Decoration = false
            end

            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") then
                    obj.CastShadow = false
                end
            end

            pcall(function()
                for _, player in pairs(game:GetService("Players"):GetPlayers()) do
                    if player.Character then
                        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
                                track:AdjustSpeed(0.1)
                            end
                        end
                    end
                end
            end)

            activeOptLevel = level

            Fluent:Notify({
                Title = "✅ Level " .. level .. " Active",
                Content = "Removed " .. removed .. " elements + All clothes & textures!",
                Duration = 5
            })
        end)
    end)
end

local function clearMapKeepNPCs()
    task.spawn(function()
        local removed = 0
        pcall(function()
            local Players = game:GetService("Players")
            local keepModels = {}

            -- หา NPC ที่มี Humanoid และไม่ใช่ Player
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                    local isPlayer = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if p.Character == obj then
                            isPlayer = true
                            break
                        end
                    end
                    if not isPlayer then
                        keepModels[obj] = true
                        -- ลบเสื้อผ้า/accessories/textures ของ NPC ทิ้งเลย
                        for _, item in pairs(obj:GetDescendants()) do
                            pcall(function()
                                if item:IsA("Accessory") or item:IsA("Hat")
                                or item:IsA("Shirt") or item:IsA("Pants")
                                or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh")
                                or item:IsA("Decal") or item:IsA("Texture")
                                or item:IsA("SpecialMesh") then
                                    item:Destroy()
                                    removed += 1
                                end
                            end)
                        end
                    end
                end
            end

            local localChar = Players.LocalPlayer.Character

            -- ลบทุกอย่างใน workspace ยกเว้น NPC + LocalPlayer
            for _, obj in pairs(workspace:GetChildren()) do
                pcall(function()
                    if obj == localChar then return end
                    if keepModels[obj] then return end
                    if obj:IsA("Terrain") then
                        obj:Clear()
                        removed += 1
                        return
                    end
                    obj:Destroy()
                    removed += 1
                end)
            end

            -- ลบ Lighting effects ทั้งหมด
            local Lighting = game:GetService("Lighting")
            for _, effect in pairs(Lighting:GetChildren()) do
                pcall(function()
                    effect:Destroy()
                end)
            end

            -- ตั้ง Lighting สว่างสุด
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.Brightness = 5
        end)

        Fluent:Notify({
            Title = "🗑️ Map Cleared",
            Content = "Removed " .. removed .. " objects. NPCs only!",
            Duration = 5
        })
    end)
end

local function createAdvancedFPS()
    if fpsGui then
        fpsGui:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ZerovectorPerformance"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.Parent = game.CoreGui

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(0, 180, 0, 70)
    Container.Position = UDim2.new(0, 15, 0, 15)
    Container.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Container.BackgroundTransparency = 0.2
    Container.BorderSizePixel = 0
    Container.Parent = ScreenGui

    local ContainerCorner = Instance.new("UICorner")
    ContainerCorner.CornerRadius = UDim.new(0, 12)
    ContainerCorner.Parent = Container

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(255, 0, 0)
    Stroke.Thickness = 2.5
    Stroke.Transparency = 0.2
    Stroke.Parent = Container

    task.spawn(function()
        local hue = 0
        while Container and Container.Parent do
            hue = (hue + 2) % 360
            Stroke.Color = Color3.fromHSV(hue / 360, 1, 1)
            task.wait(0.03)
        end
    end)

    local Gradient = Instance.new("UIGradient")
    Gradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 127)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(127, 0, 255))
    }
    Gradient.Rotation = 45
    Gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.9),
        NumberSequenceKeypoint.new(1, 0.95)
    })
    Gradient.Parent = Container

    task.spawn(function()
        local rotation = 0
        while Container and Container.Parent do
            rotation = (rotation + 1) % 360
            Gradient.Rotation = rotation
            task.wait(0.05)
        end
    end)

    local ContentFrame = Instance.new("Frame")
    ContentFrame.Size = UDim2.new(1, -10, 1, -10)
    ContentFrame.Position = UDim2.new(0, 5, 0, 5)
    ContentFrame.BackgroundTransparency = 1
    ContentFrame.Parent = Container

    local FPSLabel = Instance.new("TextLabel")
    FPSLabel.Size = UDim2.new(1, 0, 0, 30)
    FPSLabel.Position = UDim2.new(0, 0, 0, 5)
    FPSLabel.BackgroundTransparency = 1
    FPSLabel.Text = "0 FPS"
    FPSLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    FPSLabel.TextSize = 24
    FPSLabel.Font = Enum.Font.GothamBold
    FPSLabel.TextStrokeTransparency = 0.5
    FPSLabel.Parent = ContentFrame

    local StatsFrame = Instance.new("Frame")
    StatsFrame.Size = UDim2.new(1, 0, 0, 20)
    StatsFrame.Position = UDim2.new(0, 0, 0, 40)
    StatsFrame.BackgroundTransparency = 1
    StatsFrame.Parent = ContentFrame

    local PingLabel = Instance.new("TextLabel")
    PingLabel.Size = UDim2.new(0.5, -2, 1, 0)
    PingLabel.Position = UDim2.new(0, 0, 0, 0)
    PingLabel.BackgroundTransparency = 1
    PingLabel.Text = "📡 0ms"
    PingLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    PingLabel.TextSize = 11
    PingLabel.Font = Enum.Font.Gotham
    PingLabel.TextXAlignment = Enum.TextXAlignment.Left
    PingLabel.Parent = StatsFrame

    local MemLabel = Instance.new("TextLabel")
    MemLabel.Size = UDim2.new(0.5, -2, 1, 0)
    MemLabel.Position = UDim2.new(0.5, 2, 0, 0)
    MemLabel.BackgroundTransparency = 1
    MemLabel.Text = "💾 0MB"
    MemLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    MemLabel.TextSize = 11
    MemLabel.Font = Enum.Font.Gotham
    MemLabel.TextXAlignment = Enum.TextXAlignment.Right
    MemLabel.Parent = StatsFrame

    fpsGui = ScreenGui

    task.spawn(function()
        local lastTime = tick()
        local frames = 0
        local fps = 0
        local hue = 0

        game:GetService("RunService").RenderStepped:Connect(function()
            frames = frames + 1

            if tick() - lastTime >= 0.5 then
                fps = math.floor(frames * 2)

                if FPSLabel then
                    FPSLabel.Text = fps .. " FPS"
                    hue = (hue + 3) % 360
                    FPSLabel.TextColor3 = Color3.fromHSV(hue / 360, 0.8, 1)
                end

                if PingLabel then
                    local ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString()
                    PingLabel.Text = "📡 " .. ping
                end

                if MemLabel then
                    local mem = math.floor(game:GetService("Stats"):GetTotalMemoryUsageMb())
                    MemLabel.Text = "💾 " .. mem .. "MB"
                end

                frames = 0
                lastTime = tick()
            end
        end)
    end)
end

